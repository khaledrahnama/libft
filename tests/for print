1. ft_memmove

Purpose

Copies memory safely even if source and destination overlap.

Example overlap problem:

abcdef
  ^
copy from here to beginning

If copied forward incorrectly:

ababab

because original bytes get overwritten before reading them.

⸻

Implementation

#include <stddef.h>
void	*ft_memmove(void *dst, const void *src, size_t len)
{
	unsigned char		*d;
	const unsigned char	*s;
	size_t				i;
	if (!dst && !src)
		return (NULL);
	d = (unsigned char *)dst;
	s = (const unsigned char *)src;
	if (d > s)
	{
		i = len;
		while (i > 0)
		{
			i--;
			d[i] = s[i];
		}
	}
	else
	{
		i = 0;
		while (i < len)
		{
			d[i] = s[i];
			i++;
		}
	}
	return (dst);
}

⸻

Key Idea

If destination is after source in memory:

src: abcdef
dst:   ^

copying forward destroys unread data.

So copy backward instead.

⸻

Edge Cases

1. dst == src

Should still work.

ft_memmove(str, str, 5);

⸻

2. len == 0

Should do nothing.

⸻

3. NULL pointers

ft_memmove(NULL, NULL, 0);

Real libc may behave differently, but 42 usually protects this.

⸻

2. ft_split

Purpose

Split string into array of words.

ft_split("hello world 42", ' ');

returns:

["hello", "world", "42", NULL]

⸻

Why It’s Hard

Because you must manage:

* counting words
* allocating memory
* freeing on failure
* skipping delimiters
* ending with NULL

⸻

Implementation

#include <stdlib.h>
static int	count_words(char const *s, char c)
{
	int	count;
	int	i;
	count = 0;
	i = 0;
	while (s[i])
	{
		while (s[i] == c)
			i++;
		if (s[i])
			count++;
		while (s[i] && s[i] != c)
			i++;
	}
	return (count);
}
static char	*word_dup(char const *s, int start, int end)
{
	char	*word;
	int		i;
	word = malloc(end - start + 1);
	if (!word)
		return (NULL);
	i = 0;
	while (start < end)
		word[i++] = s[start++];
	word[i] = '\0';
	return (word);
}
static void	free_all(char **arr, int count)
{
	while (count--)
		free(arr[count]);
	free(arr);
}
char	**ft_split(char const *s, char c)
{
	char	**arr;
	int		i;
	int		j;
	int		start;
	if (!s)
		return (NULL);
	arr = malloc(sizeof(char *) * (count_words(s, c) + 1));
	if (!arr)
		return (NULL);
	i = 0;
	j = 0;
	while (s[i])
	{
		while (s[i] == c)
			i++;
		start = i;
		while (s[i] && s[i] != c)
			i++;
		if (i > start)
		{
			arr[j] = word_dup(s, start, i);
			if (!arr[j])
			{
				free_all(arr, j);
				return (NULL);
			}
			j++;
		}
	}
	arr[j] = NULL;
	return (arr);
}

⸻

Edge Cases

Multiple delimiters

"hello   world"

Must not create empty strings.

⸻

Empty string

""

returns:

[NULL]

⸻

String only delimiters

"     "

returns:

[NULL]

⸻

3. ft_strtrim

Purpose

Remove characters from beginning and end.

ft_strtrim("///hello///", "/");

→ "hello"

⸻

Implementation

#include <stdlib.h>
static int	is_set(char c, char const *set)
{
	int	i;
	i = 0;
	while (set[i])
	{
		if (set[i] == c)
			return (1);
		i++;
	}
	return (0);
}
char	*ft_strtrim(char const *s1, char const *set)
{
	int		start;
	int		end;
	int		i;
	char	*res;
	if (!s1 || !set)
		return (NULL);
	start = 0;
	while (s1[start] && is_set(s1[start], set))
		start++;
	end = 0;
	while (s1[end])
		end++;
	end--;
	while (end >= start && is_set(s1[end], set))
		end--;
	res = malloc(end - start + 2);
	if (!res)
		return (NULL);
	i = 0;
	while (start <= end)
		res[i++] = s1[start++];
	res[i] = '\0';
	return (res);
}

⸻

Edge Cases

Entire string removed

ft_strtrim("////", "/");

must return empty string "".

⸻

Empty set

Should return copy of original.

⸻

4. ft_substr

Purpose

Extract part of string.

ft_substr("hello", 1, 3)

→ "ell"

⸻

Implementation

#include <stdlib.h>
static size_t	ft_strlen(const char *s)
{
	size_t	i = 0;
	while (s[i])
		i++;
	return (i);
}
char	*ft_substr(char const *s, unsigned int start, size_t len)
{
	size_t	i;
	size_t	s_len;
	char	*sub;
	if (!s)
		return (NULL);
	s_len = ft_strlen(s);
	if (start >= s_len)
		return (malloc(1));
	if (len > s_len - start)
		len = s_len - start;
	sub = malloc(len + 1);
	if (!sub)
		return (NULL);
	i = 0;
	while (i < len)
	{
		sub[i] = s[start + i];
		i++;
	}
	sub[i] = '\0';
	return (sub);
}

⸻

Dangerous Edge Case

start > strlen(s)

Must return empty allocated string.

NOT crash.

⸻

5. ft_itoa

Purpose

Convert integer to string.

ft_itoa(-42)

→ "-42"

⸻

Hardest Part

Handling:

INT_MIN = -2147483648

because:

-INT_MIN

overflows.

⸻

Implementation

#include <stdlib.h>
static int	count_digits(long n)
{
	int	count;
	count = 0;
	if (n <= 0)
		count++;
	while (n)
	{
		n /= 10;
		count++;
	}
	return (count);
}
char	*ft_itoa(int n)
{
	long	num;
	int		len;
	char	*str;
	num = n;
	len = count_digits(num);
	str = malloc(len + 1);
	if (!str)
		return (NULL);
	str[len] = '\0';
	if (num == 0)
		str[0] = '0';
	if (num < 0)
	{
		str[0] = '-';
		num = -num;
	}
	while (num > 0)
	{
		str[--len] = (num % 10) + '0';
		num /= 10;
	}
	return (str);
}

⸻

Edge Cases

Zero

ft_itoa(0)

must return "0".

⸻

INT_MIN

Must not overflow.

Using long solves it.

⸻

6. ft_calloc

Purpose

Allocate memory AND zero it.

⸻

Implementation

#include <stdlib.h>
void	*ft_calloc(size_t count, size_t size)
{
	void			*ptr;
	size_t			total;
	unsigned char	*p;
	size_t			i;
	total = count * size;
	if (size != 0 && total / size != count)
		return (NULL);
	ptr = malloc(total);
	if (!ptr)
		return (NULL);
	p = (unsigned char *)ptr;
	i = 0;
	while (i < total)
	{
		p[i] = 0;
		i++;
	}
	return (ptr);
}

⸻

Critical Edge Case

Integer overflow

count * size

can wrap around.

Without protection:

calloc(huge, huge)

allocates tiny memory accidentally.

Very dangerous.

⸻

7. ft_strmapi

Purpose

Create new transformed string.

⸻

Implementation

#include <stdlib.h>
char	*ft_strmapi(char const *s, char (*f)(unsigned int, char))
{
	char	*res;
	int		i;
	if (!s || !f)
		return (NULL);
	res = malloc(strlen(s) + 1);
	if (!res)
		return (NULL);
	i = 0;
	while (s[i])
	{
		res[i] = f(i, s[i]);
		i++;
	}
	res[i] = '\0';
	return (res);
}

⸻

Important Idea

Function pointer:

f(index, char)

lets user customize transformation.

⸻

8. ft_striteri

Difference From strmapi

Modifies original string directly.

No allocation.

⸻

Implementation

void	ft_striteri(char *s, void (*f)(unsigned int, char*))
{
	unsigned int	i;
	if (!s || !f)
		return ;
	i = 0;
	while (s[i])
	{
		f(i, &s[i]);
		i++;
	}
}

⸻

Important Detail

Pass address:

&s[i]

because function modifies character.

⸻

9. ft_lstclear

Purpose

Free entire linked list safely.

⸻

Implementation

#include <stdlib.h>
void	ft_lstclear(t_list **lst, void (*del)(void *))
{
	t_list	*temp;
	if (!lst || !del)
		return ;
	while (*lst)
	{
		temp = (*lst)->next;
		del((*lst)->content);
		free(*lst);
		*lst = temp;
	}
}

⸻

Key Idea

Save next node BEFORE freeing current.

Otherwise:

free(node);
node = node->next;

becomes invalid memory access.

⸻

10. ft_lstmap

Purpose

Create NEW list with transformed content.

⸻

Why Hard

Must:

* allocate new nodes
* transform safely
* free everything on failure

⸻

Implementation

t_list	*ft_lstmap(t_list *lst, void *(*f)(void *),
			void (*del)(void *))
{
	t_list	*new_list;
	t_list	*new_node;
	void	*content;
	new_list = NULL;
	while (lst)
	{
		content = f(lst->content);
		new_node = ft_lstnew(content);
		if (!new_node)
		{
			del(content);
			ft_lstclear(&new_list, del);
			return (NULL);
		}
		ft_lstadd_back(&new_list, new_node);
		lst = lst->next;
	}
	return (new_list);
}

⸻

Why ft_lstmap Is Difficult

Because partial failure creates leaks.

Example:

node1 success
node2 success
node3 malloc fails

You must free:

* node1
* node2
* transformed contents

Otherwise memory leak.

⸻

Most Common libft Mistakes

1. Forgetting NULL terminator

malloc(len)

instead of:

malloc(len + 1)

⸻

2. Leaks on allocation failure

Especially in:

* split
* lstmap

⸻

3. Overlap bugs

Using memcpy instead of memmove.

⸻

4. INT_MIN overflow

Very common in itoa.

⸻

5. Returning stack memory

Wrong:

char str[10];
return str;

because stack disappears after function ends.